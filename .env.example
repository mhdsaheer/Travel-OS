# Copy to .env and configure your own backend. Never commit private secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server runtime configuration, for your own backend only:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: database connection for drizzle-kit, from your own backend:
DATABASE_URL=
